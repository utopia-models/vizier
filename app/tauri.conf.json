{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vizier",
  "version": "0.2.0",
  "identifier": "ai.utopiamodels.vizier",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Utopia Vizier",
        "width": 1280,
        "height": 680,
        "x": 0,
        "y": 720,
        "alwaysOnTop": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "skipTaskbar": false,
        "visible": false,
        "contentProtected": true,
        "useHttpsScheme": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
