# Vizier server configuration. Copy to vizier.env and edit; `vizier.py --config vizier.env`.
# A variable already set in the environment wins over this file. Never commit a filled-in copy.

# --- where ---
# VIZIER_HOST=127.0.0.1
# VIZIER_PORT=8786
# VIZIER_TOKEN=                  # when set, every POST needs `Authorization: Bearer <token>`
# VIZIER_ALLOWED_ORIGINS=https://my-dashboard.example

# --- data ---
# VIZIER_DATA=~/.vizier          # default home for everything below
# VIZIER_LOG=$VIZIER_DATA/events.jsonl
# VIZIER_SCRIPTS=$VIZIER_DATA/scripts.md         # the prompter's starting script; POST /script replaces it live
# VIZIER_TALK_SCRIPTS=$VIZIER_DATA/talk-scripts  # /prompter/scripts?file=<name>
# VIZIER_BRIEFS=$VIZIER_DATA/briefs              # /prompter/scripts?brief=<slug>
# VIZIER_TAKES=$VIZIER_DATA/takes
# VIZIER_BUILD_LOG=$VIZIER_DATA/build-log.md
# VIZIER_MAX_LINES=5000          # final lines a call keeps in memory

# --- recording (optional; needs ffmpeg) ---
# VIZIER_CAM=rtsp://127.0.0.1:8554/live/cam     # the camera stream the prompter's R key copies into a take
